# ==============================================================================
# CampusConnect Environment Variables Template
# Copy this file to `.env` for local development (NEVER commit `.env` to GitHub).
# Set these same variables in Vercel Dashboard -> Project -> Settings -> Env Vars.
# ==============================================================================

# Server Port (Local / Cloud Run / Render; ignored on Vercel Serverless)
PORT=3000

# Runtime Mode: "development" locally, "production" on Vercel/Cloud Run
NODE_ENV=development

# MongoDB Atlas Connection String (Required in production; strongly recommended locally)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=

# Optional Storage Override for Local Dev Only ("atlas" or "local").
# Leaving unset uses Atlas if MONGODB_URI is set, otherwise local JSON (.data/).
# NOTE: STORAGE_MODE=local is strictly forbidden in production.
STORAGE_MODE=

# JWT Signing Secret (REQUIRED in production: >= 32 characters cryptographically random string)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public Application URL
# Local: http://localhost:3000
# Vercel Production: https://your-project.vercel.app
APP_URL="http://localhost:3000"

# Optional Comma-Separated Additional Allowed CORS Origins
# Example: https://custom-domain.edu,https://portal.hinduuniversity.edu
CORS_ALLOWED_ORIGINS=

# Email Delivery Option A (Recommended when deploying on free *.vercel.app without a custom domain):
# Gmail SMTP (or Brevo SMTP) — delivers OTP & ticket emails directly to ANY user inbox.
# For Gmail: enable 2-Step Verification -> create a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Email Delivery Option B (Resend API — requires a verified custom domain for external recipients)
RESEND_API_KEY=

# Optional Google Gemini API Key (if AI features are enabled)
GEMINI_API_KEY=

# Optional MongoDB Connection Pool Tuning (use <=10 on Vercel Serverless Free Tier)
MONGODB_MAX_POOL_SIZE=10
